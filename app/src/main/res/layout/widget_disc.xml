<?xml version="1.0" encoding="utf-8"?>
<!--
"Disc" home-screen widget. The whole face is one bitmap (see DiscWidgetRenderer);
the two FrameLayouts on top are transparent click areas. Only RemoteViews-safe classes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/dw_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/dw_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/dw_hit_disc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:contentDescription="@string/dw_cd_play" />

        <FrameLayout
            android:id="@+id/dw_hit_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3" />
    </LinearLayout>
</FrameLayout>
