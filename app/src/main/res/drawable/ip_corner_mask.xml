<?xml version="1.0" encoding="utf-8"?>
<!--
Top-left corner mask: the part of a 14dp square that lies OUTSIDE a quarter circle. Drawn in the body
colour on the 4 corners of the screen (rotated 90 / 180 / 270 for the others) it rounds the screen's
corners without stretching, whatever the screen's size. Keep the colour equal to ip_body.xml's.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="14dp"
    android:height="14dp"
    android:viewportWidth="14"
    android:viewportHeight="14">
    <path
        android:fillColor="#FF9E9E9F"
        android:pathData="M0,0 L14,0 A14,14 0 0 0 0,14 Z" />
</vector>